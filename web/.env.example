# Existing Student/Institute API; unchanged.
VITE_SERVER_URL=https://coachingbuddy.co.in/api

# PUBLIC Cloudflare Worker URL; this is NOT a secret.
# Example after deploying Worker: https://coachingbuddy-seo-publisher.<your-account>.workers.dev
VITE_SEO_WORKER_URL=https://replace-with-your-worker.workers.dev

# Never put passwords, password hashes, GitHub tokens or session signing keys in VITE_ variables.
