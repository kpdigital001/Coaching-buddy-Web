# Existing API used by the React/Vite portal
VITE_SERVER_URL=https://coachingbuddy.co.in/api

# Comma-separated institute-admin emails allowed to access /seo-admin
VITE_SEO_ADMIN_EMAILS=seo@coachingbuddy.co.in

# SHA-256 verifier for the SEO-only secondary password gate.
# Do NOT put the plaintext SEO password in this file.
VITE_SEO_ADMIN_PASSWORD_SHA256=replace-with-64-character-sha256-hash
