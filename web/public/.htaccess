<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Original application's API and SEO PHP publisher are independent.
  RewriteRule ^api(/|$) - [L,NC]
  RewriteRule ^seo-publisher(/|$) - [L,NC]

  # Backward-compatible public config always reflects the current published version.
  RewriteRule ^seo-overrides\.json$ seo-publisher/published.php [L,NC]

  # Existing real assets continue to serve directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Initial HTML SEO metadata + original React Router client app.
  RewriteRule ^$ seo-entry.php [L]
  RewriteRule ^ seo-entry.php [L]
</IfModule>
DirectoryIndex seo-entry.php index.html
<FilesMatch "^(\.env|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>